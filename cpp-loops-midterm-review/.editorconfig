# Consistent formatting across editors. The examples use 4 spaces, never tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,html,css,js,json}]
indent_size = 2

[*.py]
indent_size = 4

[build_check.sh]
indent_size = 2
